# Copie este ficheiro para `.env.local` e preencha com os valores reais.
# Nunca faça commit de `.env.local` — está ignorado em `.gitignore`.

# Base de dados PostgreSQL (Render, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Segredo usado para assinar tokens de sessão (mínimo 32 caracteres aleatórios).
SESSION_SECRET=troque-este-segredo-por-um-muito-longo-e-aleatorio

# Conta com privilégios de administrador (fica com is_admin=true ao registar-se).
ADMIN_EMAIL=admin@exemplo.com

# Resend (envio de e-mails transacionais via HTTPS). As quatro chaves abaixo
# são obrigatórias — a app falha no arranque do fluxo de e-mail se faltar alguma.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Cliente Mistério <noreply@seudominio.com>"
EMAIL_REPLY_TO=suporte@exemplo.com

# URL pública da app usada para construir links nos e-mails (ex.: reset de
# password), sem barra final.
APP_URL=http://localhost:3000

# URL base absoluta antiga — ainda usada apenas como fallback de SEO
# (canonical/sitemap) em app/lib/site.ts. Os links de e-mail usam APP_URL, acima.
APP_BASE_URL=http://localhost:3000

# URL pública e definitiva do site (com domínio próprio), usada em
# canonical, sitemap.xml, robots.txt e Open Graph — essencial para SEO.
# Sem esta variável em produção (Railway > Settings > Variables), estas
# tags podem acabar a apontar para localhost ou para o subdomínio do
# alojamento, e o Google deixa de conseguir indexar o site corretamente.
NEXT_PUBLIC_SITE_URL=https://clientemisterio.com

# Stripe - Link público apresentado no checkout.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx

# Stripe - Chave secreta do servidor (exigida para webhooks).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe - Segredo do endpoint webhook (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Swagger/OpenAPI em produção (por defeito escondido).
ENABLE_PUBLIC_API_DOCS=false
